{
    "manifest_version": 3,

    "name": "Project Flow",

    "version": "1.1",

    "description": "Automatic form autofill extension",

    "permissions": [
        "storage",
        "activeTab",
        "tabs"
    ],

    "host_permissions": [
        "http://localhost:8000/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "http://127.0.0.1:5500/*",
                "https://*.myworkdayjobs.com/*",
                "https://*.workday.com/*"
            ],
           "js": [
    "profileApi.js",
     "fieldDitector.js",
    "content.js"
]
        }
    ]
}
